[Unit]
Description=even-window API (mirror a PC window to Even Realities G2)
Documentation=file://%f/docs/getting-started.md
Wants=network-online.target
After=network-online.target
# The host display is needed only for the Xephyr backend. A headless run uses Xvfb, so
# this is an ordering hint and not a dependency: with EW_HOST_DISPLAY= (empty) the
# service starts with no desktop (docs/configuration.md).
After=graphical-session.target

[Service]
Type=simple
# The instance name is the systemd-escaped absolute path of the checkout; %f turns it
# back into a filesystem path.
WorkingDirectory=%f
# Both files are read, here and by the server itself, with the same result: a key set in
# both takes the value from ~/.even-window/env. The later file wins in systemd, so that
# one comes last.
# The leading `-` tolerates a missing file.
EnvironmentFile=-%h/.config/even-window/env
EnvironmentFile=-%h/.even-window/env
ExecStart=/usr/bin/env node %f/src/server/main.ts
# Stop and restart signal the server only. The mirrored desktop (X server, window manager,
# applications) is in the same control group and must outlive the server, so that a restart
# re-attaches to it.
#
# To end the desktop too, stop the unit and then kill the X server by pid; its window
# manager and applications go with it (docs/getting-started.md, "Stop and clean up"):
#   systemctl --user stop <unit>
#   pgrep -af 'Xephyr :100|Xvfb :100'    # find the pid; do not use pkill -f
#   kill <pid>
#   rm -f <checkout>/.ew-x11/session.json
KillMode=process
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
