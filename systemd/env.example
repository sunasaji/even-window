# Copy this file to ~/.pinhole-window/env (or ~/.config/pinhole-window/env) and make it
# readable only by your user (chmod 600). A file that others can write is ignored.
#
# The server and scripts/pw-auth.mjs read it automatically; the systemd unit reads the
# same file through EnvironmentFile=. Precedence: environment variables, then this file,
# then defaults. The start-up banner names every setting taken from here.
#
# Format: a strict subset of systemd's EnvironmentFile=, so one file works both ways.
#   * KEY=VALUE, PINHOLE_* keys only; one layer of matching quotes is stripped
#   * comments start with # or ;
#   * no `export`, no $VAR expansion (values are literal, `~` included), no line
#     continuations, no spaces around `=`
# Any other line is refused with a message. Full reference: docs/configuration.md.

# ── authentication (docs/security.md) ────────────────────────────────────────────────
# Enforced by default; only 0/off/false/no disable it. Keep it at 1.
PINHOLE_AUTH=1

# The URL the device dials. When set, the server refuses session signatures made out to
# any other origin, so a phished `?server=` cannot relay your phone's signature here.
# Unset: signatures are verified but the origin is not compared.
# PINHOLE_ORIGIN=https://host.ts.net:8443

# Maximum number of enrolled keys. A device that pairs again generates a new key, so 1
# forces revoking the old key first. 0/unlimited/off/none removes the limit.
# Lowering it revokes nothing: if more keys are enrolled than it allows, the server
# refuses to start until the extra keys are revoked (`scripts/pw-auth.mjs revoke`).
PINHOLE_MAX_CLIENTS=1

# ── network ──────────────────────────────────────────────────────────────────────────
# Loopback only. The server terminates no TLS: put a TLS proxy such as `tailscale serve`
# in front (docs/getting-started.md) instead of publishing this port.
PINHOLE_HOST=127.0.0.1
PINHOLE_PORT=8787

# Extra CORS origins, comma-separated. Unrelated to PINHOLE_ORIGIN above.
# PINHOLE_ORIGINS=

# ── the mirrored desktop (docs/platform.md) ──────────────────────────────────────────
# Display number of the nested X server, and where its runtime files live.
# PINHOLE_X11_DISPLAY=:100
# PINHOLE_X11_RUNTIME_DIR=/path/to/checkout/.pw-x11

# auto, xephyr or xvfb. auto falls back to the other one; a pinned backend does not.
# PINHOLE_BACKEND=auto

# The host display Xephyr opens its window on. Empty means "there is no host desktop"
# and prefers headless Xvfb, the usual choice for a service that starts before login.
# PINHOLE_HOST_DISPLAY=

# The program started in an empty mirrored desktop; empty starts nothing. Keep it dark:
# the glasses are see-through, so black is transparent and a light background lights the
# whole lens.
# PINHOLE_SPAWN=xterm -bg black -fg white
# PINHOLE_SPAWN_CWD=~/work      # `~` is expanded by the server, not by this file

# Capture rate (1 to 30), and font antialiasing (off by default: grey fringes quantise
# badly to 16 levels).
# PINHOLE_FPS=10
# PINHOLE_AA=0

# ── state and diagnostics ────────────────────────────────────────────────────────────
# Where clients.json, server-secret, apps.conf and bindings.json live.
# PINHOLE_STATE_DIR=/home/you/.pinhole-window   # an absolute path: `~` is literal here
# PINHOLE_QUIET=1                     # silence the per-request access log

# ── speech to text (docs/voice.md) ───────────────────────────────────────────────────
# URL of an OpenAI-compatible POST /v1/audio/transcriptions endpoint. Unset or empty
# keeps voice input off. With speech.cpp (systemd/speech-cpp.service runs this):
#   speech serve qwen3-asr-0.6b --port 8757
# Do not pass --threads: the default, the physical core count, is correct.
# PINHOLE_STT_URL=http://127.0.0.1:8757/v1/audio/transcriptions
#
# The model id the recogniser's /v1/models reports, which differs from the speech.cpp
# CLI name: qwen3-asr-0.6b -> Qwen3-ASR-0.6B.
# A wrong id gets a 404. The default is Qwen3-ASR-0.6B, matching
# systemd/speech-cpp.service. Check it:
#   curl -s http://127.0.0.1:8757/v1/models | grep -o '"id":"[^"]*"'
# PINHOLE_STT_MODEL=Qwen3-ASR-0.6B
# PINHOLE_STT_LANG=en
#
# Vocabulary hint (speech.cpp's `prompt`). It also makes the recogniser likelier to hear
# these words when they were not said.
# PINHOLE_STT_PROMPT=Claude Code, リポジトリ, コミット
#
# A hosted recogniser instead of a local one (docs/voice.md). The audio then leaves this
# machine. The key is sent as `Authorization: Bearer`; with it set the URL must be https.
# PINHOLE_STT_URL=https://api.openai.com/v1/audio/transcriptions
# PINHOLE_STT_MODEL=gpt-4o-mini-transcribe
# PINHOLE_STT_API_KEY=sk-...
#
# Extra form fields for the recogniser, as name=value pairs joined by `&`. None by default,
# and the shipped setup needs none. A recogniser that answers 400 is asked again without
# them (docs/voice.md).
# PINHOLE_STT_OPTIONS=name=value&other=value
#
# For diagnosis only: keep each utterance (the WAV sent and the text answered) in this
# directory, newest 20. These are recordings of your voice; leave it unset in normal use.
# PINHOLE_STT_DUMP_DIR=/home/you/.local/state/pinhole-window/stt-dump
