{
  "name": "even-window",
  "version": "0.1.1",
  "private": true,
  "description": "Mirror a PC window to Even Realities G2 smart glasses, with lightweight remote control",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "server": "node src/server/main.ts",
    "test": "vitest run",
    "sim": "bash scripts/sim.sh",
    "pack": "npm run build && evenhub pack app.json dist -o out.ehpk",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
