{
  "name": "even-window",
  "version": "0.1.0",
  "private": true,
  "description": "Mirror a PC window to Even Realities G2 smart glasses, with lightweight remote control",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "server": "node src/server/main.ts",
    "test": "vitest run",
    "sim": "bash scripts/sim.sh"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-simulator": "*",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
